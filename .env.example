# Optional overrides for config/config.yaml. Copy to .env (read automatically) or set
# the variables in your shell; a variable already set in the shell wins over .env.
# Kaggle credentials are NOT read from here: the Kaggle API reads its own config
# (see the Kaggle documentation) or the KAGGLE_USERNAME / KAGGLE_KEY variables.

# Folder for the raw download, Parquet cache and DuckDB warehouse
XSELL_DATA_DIR=data

# DuckDB memory cap, about 40% of RAM (8 GB laptop: 3GB, 16 GB laptop: 4GB to 6GB)
XSELL_DUCKDB_MEMORY_LIMIT=4GB

# DuckDB worker threads, logical cores minus 2 (minimum 2)
XSELL_THREADS=10
